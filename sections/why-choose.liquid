<link rel="stylesheet" href="{{ 'section-why-choose.css' | asset_url }}">
<script src="{{ 'section-why-choose.js' | asset_url }}" defer></script>

{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'why_choose.heading' | t
  endif
  assign pagination_index = '{{index}}'
%}

<why-choose
  class="why-choose full-width"
  aria-labelledby="WhyChooseHeading-{{ section.id }}"
  data-page-label="{{ 'why_choose.go_to_page' | t: number: pagination_index | escape }}"
>
  <div class="why-choose__inner">
    <h2 class="why-choose__heading" id="WhyChooseHeading-{{ section.id }}">{{ heading | escape }}</h2>
    <div class="why-choose__viewport">
      <ul class="why-choose__list swiper-wrapper" role="list">
        {% for block in section.blocks %}
          {% assign benefit = block.settings %}
          <li class="why-choose__card swiper-slide" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="why-choose__icon" aria-hidden="true">
              {% if benefit.image != blank %}
                {{ benefit.image | image_url: width: 144 | image_tag: loading: 'lazy', widths: '48, 96, 144', sizes: '48px', alt: '' }}
              {% else %}
                {% render 'why-choose-icon', icon: benefit.icon %}
              {% endif %}
            </div>
            {% if benefit.title != blank %}
              <h3 class="why-choose__title">{{ benefit.title | escape | newline_to_br }}</h3>
            {% endif %}
            {% if benefit.description != blank %}
              <p class="why-choose__description">{{ benefit.description | escape }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="why-choose__pagination" hidden></div>
  </div>
</why-choose>

{% schema %}
{
  "name": "t:general.why_choose",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Why Choose Redragon" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:general.benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "t:labels.benefit_icon", "default": "shipping",
          "options": [
            { "value": "shipping", "label": "t:options.benefit_icon.shipping" },
            { "value": "returns", "label": "t:options.benefit_icon.returns" },
            { "value": "warranty", "label": "t:options.benefit_icon.warranty" },
            { "value": "rewards", "label": "t:options.benefit_icon.rewards" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "t:labels.benefit_image", "info": "t:labels.benefit_image_info" },
        { "type": "textarea", "id": "title", "label": "t:labels.heading" },
        { "type": "textarea", "id": "description", "label": "t:labels.description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.why_choose",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "shipping", "title": "Free U.S.\nEconomy Shipping", "description": "Orders over $49 qualify for free shipping. Track your parcel anytime." } },
        { "type": "benefit", "settings": { "icon": "returns", "title": "30-Day\nReturn Policy", "description": "Return your order within 30 days." } },
        { "type": "benefit", "settings": { "icon": "warranty", "title": "2-Year\nLimited Warranty", "description": "Only available on redragonshop." } },
        { "type": "benefit", "settings": { "icon": "rewards", "title": "Enjoy Your\nRedragon Perks", "description": "Join Redragon Reward Program and enjoy exclusive deals and rewards." } }
      ]
    }
  ]
}
{% endschema %}
