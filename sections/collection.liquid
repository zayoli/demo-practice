<link rel="stylesheet" href="{{ 'section-collection.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-catalog.css' | asset_url }}">
<script src="{{ 'storefront-filters.js' | asset_url }}" defer></script>

<div class="collection-page catalog-page">
  <h1>{{ collection.title | escape }}</h1>
  {% paginate collection.products by 20 %}
    <div class="catalog-layout{% if section.settings.enable_filtering %}{% if collection.filters.size > 0 %} catalog-layout--filtered{% endif %}{% endif %}">
      {% if section.settings.enable_filtering %}
        {% render 'storefront-filters', results: collection, section_id: section.id %}
      {% endif %}
      <div class="catalog-content">
        <p class="catalog-count">{{ 'filters.product_count' | t: count: collection.products_count }}</p>
        <div class="collection-products catalog-grid">
          {% for product in collection.products %}
            {% render 'catalog-card', item: product %}
          {% else %}
            <p class="catalog-empty">{{ 'filters.no_products' | t }}</p>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="catalog-pagination" aria-label="{{ 'filters.pagination' | t | escape }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [{ "type": "checkbox", "id": "enable_filtering", "label": "t:labels.enable_filtering", "default": true }]
}
{% endschema %}
