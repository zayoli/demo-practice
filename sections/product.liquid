<link rel="stylesheet" href="{{ 'section-product.css' | asset_url }}">
<script src="{{ 'section-product.js' | asset_url }}" defer></script>

{% assign youtube_video_url = product.metafields.custom.youtube_video.value | strip %}
{% assign product_features = product.metafields.custom.product_detail_image_and_text.value %}
{% assign product_overview = product.metafields.custom.product_overview %}
{% assign product_accordion_items = product.metafields.custom.product_accordion.value %}
{% assign specifications_anchor = 'ProductDetails-' | append: section.id %}
{% if product_accordion_items != blank %}
  {% assign specifications_anchor = 'ProductAccordion-' | append: section.id %}
{% endif %}
{% assign anchor_variant = product.selected_or_first_available_variant %}
{% assign anchor_can_purchase = false %}
{% if anchor_variant.available %}
  {% unless product.requires_selling_plan %}
    {% assign anchor_can_purchase = true %}
  {% endunless %}
{% endif %}
{% assign has_product_overview = false %}
{% if product_overview != blank and product_overview.value != blank %}
  {% assign has_product_overview = true %}
{% elsif product.description != blank %}
  {% assign has_product_overview = true %}
{% endif %}
{% if youtube_video_url != blank %}
  <link rel="stylesheet" href="{{ 'vidstack-theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'vidstack-video.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'product-video.css' | asset_url }}">
  <script src="{{ 'product-video.js' | asset_url }}" defer></script>
{% endif %}

<product-detail
  class="product-page full-width"
  data-section-id="{{ section.id }}"
  data-loading-message="{{ 'product.loading' | t | escape }}"
  data-error-message="{{ 'product.selection_error' | t | escape }}"
>
  <div class="product-page__container">
    <nav class="product-page__breadcrumb" aria-label="{{ 'product.breadcrumb' | t | escape }}">
      <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">{{ 'product.products' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>
    <div class="product-page__main">
      {% render 'product-gallery', product: product, section_id: section.id %}
      {% render 'product-info', product: product, section: section %}
    </div>
    <div class="product-page__request" role="status" aria-live="polite" hidden data-product-status></div>
    <a class="product-page__retry" href="{{ product.url }}" hidden data-product-retry>
      {{- 'product.open_selection' | t -}}
    </a>
  </div>
  <nav class="product-anchor product-page__container" aria-label="{{ 'product.product_information' | t | escape }}">
    <div class="product-anchor__inner">
      <p class="product-anchor__title">{{ product.title | escape }}</p>
      <div class="product-anchor__links">
        {% if has_product_overview %}
          <a href="#ProductOverview-{{ section.id }}">{{ 'product.overview' | t }}</a>
        {% endif %}
        <a href="#{{ specifications_anchor }}">{{ 'product.details' | t }}</a>
      </div>
      <div class="product-anchor__actions">
        <button type="button" class="product-anchor__add" data-product-anchor-add>
          {{ 'top_picks.add_to_cart' | t }}
        </button>
        {% if section.settings.show_dynamic_checkout and anchor_can_purchase %}
          <button type="button" class="product-anchor__buy" data-product-anchor-buy>
            {{ 'product.buy_now' | t }}
          </button>
        {% endif %}
      </div>
    </div>
  </nav>
  <div class="product-page__details">
    <div class="product-page__container">
      <section
        class="product-page__specifications"
        id="ProductDetails-{{ section.id }}"
      >
        {% for feature in product_features %}
          {% render 'product-feature', feature: feature %}
        {% endfor %}
        {% if has_product_overview or product_accordion_items != blank %}
          <div class="product-page__detail-copy">
            {% if has_product_overview %}
              <section
                class="product-page__overview"
                id="ProductOverview-{{ section.id }}"
                aria-labelledby="ProductOverviewTitle-{{ section.id }}"
              >
                <h2 id="ProductOverviewTitle-{{ section.id }}">{{ 'product.overview' | t }}</h2>
                {% if product_overview != blank and product_overview.value != blank %}
                  <div class="product-page__rte" data-product-description>{{ product_overview | metafield_tag }}</div>
                {% elsif product.description != blank %}
                  <div class="product-page__rte" data-product-description>{{ product.description }}</div>
                {% endif %}
              </section>
            {% endif %}
            {% if product_accordion_items != blank %}
              <div class="product-accordion" id="ProductAccordion-{{ section.id }}" data-product-accordion>
                {% for accordion_item in product_accordion_items %}
                  {% render 'product-accordion-item', item: accordion_item %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </section>
    </div>
  </div>
  {% if youtube_video_url != blank %}
    <div class="product-page__container">
      {% render 'product-video', video_url: youtube_video_url, product: product, section_id: section.id %}
    </div>
  {% endif %}
</product-detail>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
