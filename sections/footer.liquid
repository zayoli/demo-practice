<footer class="site-footer full-width">
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <div class="site-footer__intro">
        <a class="site-footer__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
        <p class="site-footer__description">
          {% if section.settings.description != blank %}
            {{ section.settings.description | escape | newline_to_br }}
          {% else %}
            {{ 'footer.description' | t }}
          {% endif %}
        </p>
      </div>

      <nav aria-label="{{ 'footer.navigation' | t | escape }}">
        <h2 class="site-footer__heading">{{ 'footer.explore' | t }}</h2>
        <ul class="site-footer__links" role="list">
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {% else %}
            <li><a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">{{ 'header.shop' | t }}</a></li>
            <li><a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a></li>
            <li><a href="{{ routes.cart_url }}">{{ 'cart.title' | t }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ 'footer.rights' | t }}</p>
      {% if section.settings.show_payment_icons %}
        {% if shop.enabled_payment_types.size > 0 %}
          <ul class="site-footer__payments" role="list" aria-label="{{ 'footer.payment_methods' | t | escape }}">
            {% for payment_type in shop.enabled_payment_types %}
              <li>{{ payment_type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    height: 554px;
    padding: 64px 24px 24px;
    background: #252b27;
    color: #f6f6ef;
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    width: min(100%, 1280px);
    height: 100%;
    margin-inline: auto;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    min-height: 0;
    flex: 1;
    padding-bottom: 32px;
    overflow-y: auto;
  }

  .site-footer__intro {
    min-width: 0;
  }

  .site-footer__brand {
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }

  .site-footer__description {
    max-width: 34ch;
    margin-top: 24px;
    color: #c0c9c1;
    font-size: 15px;
    line-height: 1.8;
  }

  .site-footer__heading {
    margin-bottom: 20px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 24px;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    gap: 16px 32px;
    padding-top: 24px;
    border-top: 1px solid #4b534c;
    color: #c0c9c1;
    font-size: 12px;
    line-height: 1.6;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .site-footer__payments svg {
    width: 36px;
    height: 24px;
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 40px 20px 24px;
    }

    .site-footer__main {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 32px;
      padding-bottom: 24px;
    }

    .site-footer__description {
      margin-top: 12px;
    }

    .site-footer__heading {
      margin-bottom: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "description", "label": "t:labels.description" },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "footer" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true }
  ]
}
{% endschema %}
