<link rel="stylesheet" href="{{ 'section-top-picks.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-top-picks-card.css' | asset_url }}">
<script src="{{ 'component-top-picks-card.js' | asset_url }}" defer></script>
<script src="{{ 'section-top-picks.js' | asset_url }}" defer></script>

{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'top_picks.heading' | t
  endif
  assign pagination_index = '{{index}}'
%}

<top-picks
  class="top-picks full-width"
  aria-labelledby="TopPicksHeading-{{ section.id }}"
  data-page-label="{{ 'top_picks.go_to_page' | t: number: pagination_index | escape }}"
>
  <h2 class="top-picks__heading" id="TopPicksHeading-{{ section.id }}">{{ heading | escape }}</h2>

  <div class="top-picks__tabs" role="tablist" aria-label="{{ heading | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign tab_label = block.settings.title
        if tab_label == blank
          assign tab_label = 'top_picks.category' | t
        endif
      %}
      <a
        class="top-picks__tab"
        id="TopPicksTab-{{ section.id }}-{{ block.id }}"
        href="#TopPicksPanel-{{ section.id }}-{{ block.id }}"
        role="tab"
        aria-controls="TopPicksPanel-{{ section.id }}-{{ block.id }}"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        data-block-id="{{ block.id }}"
        {{ block.shopify_attributes }}
      >{{ tab_label | escape }}</a>
    {% endfor %}
  </div>

  <div class="top-picks__content">
    {% for block in section.blocks %}
      {% liquid
        assign group_settings = block.settings
        assign selected_products = group_settings.products
        if selected_products == blank
          assign selected_products = group_settings.collection.products
        endif
      %}
      <div
        class="top-picks__panel"
        id="TopPicksPanel-{{ section.id }}-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="TopPicksTab-{{ section.id }}-{{ block.id }}"
        data-block-id="{{ block.id }}"
        tabindex="0"
      >
        <div class="top-picks__viewport swiper">
          <div class="swiper-wrapper" id="TopPicksProducts-{{ section.id }}-{{ block.id }}">
            {% for picked_product in selected_products limit: section.settings.product_limit %}
              <div class="top-picks__slide swiper-slide">
                {% capture form_id %}TopPicksForm-{{ section.id }}-{{ block.id }}-{{ picked_product.id }}{% endcapture %}
                {% render 'top-picks-card', card_product: picked_product, form_id: form_id, promotion: section.settings.promotion %}
              </div>
            {% else %}
              {% if group_settings.example_group != 'none' %}
                {% for example_index in (0..5) limit: section.settings.product_limit %}
                  <div class="top-picks__slide swiper-slide">
                    {% render 'top-picks-card', example_group: group_settings.example_group, example_index: example_index, promotion: section.settings.promotion %}
                  </div>
                {% endfor %}
              {% else %}
                <p class="top-picks__empty">{{ 'top_picks.empty' | t }}</p>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="top-picks__controls" hidden>
          <button class="top-picks__arrow top-picks__arrow--previous" type="button" aria-label="{{ 'top_picks.previous' | t | escape }}" aria-controls="TopPicksProducts-{{ section.id }}-{{ block.id }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="m14 5-7 7 7 7" /></svg>
          </button>
          <button class="top-picks__arrow top-picks__arrow--next" type="button" aria-label="{{ 'top_picks.next' | t | escape }}" aria-controls="TopPicksProducts-{{ section.id }}-{{ block.id }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="m10 5 7 7-7 7" /></svg>
          </button>
          <div class="top-picks__pagination"></div>
        </div>
      </div>
    {% endfor %}
  </div>
</top-picks>

{% schema %}
{
  "name": "t:general.top_picks",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Top Picks For You" },
    { "type": "text", "id": "promotion", "label": "t:labels.promotion" },
    { "type": "range", "id": "product_limit", "label": "t:labels.product_limit", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:general.product_category",
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.heading" },
        { "type": "collection", "id": "collection", "label": "t:labels.product_collection" },
        { "type": "product_list", "id": "products", "label": "t:labels.products", "limit": 12, "info": "t:labels.products_info" },
        {
          "type": "select",
          "id": "example_group",
          "label": "t:labels.example_products",
          "info": "t:labels.example_products_info",
          "options": [
            { "value": "none", "label": "t:options.example_image.none" },
            { "value": "best_sellers", "label": "t:options.product_category.best_sellers" },
            { "value": "new_arrivals", "label": "t:options.product_category.new_arrivals" },
            { "value": "bundle_deals", "label": "t:options.product_category.bundle_deals" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.top_picks",
      "blocks": [
        { "type": "category", "settings": { "title": "Best Sellers", "example_group": "best_sellers" } },
        { "type": "category", "settings": { "title": "New Arrivals", "example_group": "new_arrivals" } },
        { "type": "category", "settings": { "title": "Bundle Deals", "example_group": "bundle_deals" } }
      ]
    }
  ]
}
{% endschema %}
