{% liquid
  assign pagination_index = '{{index}}'
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'slideshow.heading' | t
  endif
%}

<hero-slideshow
  class="slideshow full-width"
  role="region"
  aria-roledescription="{{ 'slideshow.carousel' | t | escape }}"
  aria-labelledby="SlideshowHeading-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
  data-speed="{{ section.settings.speed }}"
  data-go-to-label="{{ 'slideshow.go_to_slide' | t: number: pagination_index | escape }}"
  data-first-label="{{ 'slideshow.first' | t | escape }}"
  data-last-label="{{ 'slideshow.last' | t | escape }}"
  style="--slideshow-mobile-ratio: {{ section.settings.mobile_ratio }};"
>
  {% if section.index == 1 %}
    <h1 class="slideshow__visually-hidden" id="SlideshowHeading-{{ section.id }}">{{ heading | escape }}</h1>
  {% else %}
    <h2 class="slideshow__visually-hidden" id="SlideshowHeading-{{ section.id }}">{{ heading | escape }}</h2>
  {% endif %}

  <div class="slideshow__viewport swiper">
    <div class="swiper-wrapper" id="SlideshowSlides-{{ section.id }}">
      {% for block in section.blocks %}
        {% liquid
          assign slide_settings = block.settings
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
          if forloop.first
            unless section.index > 1
              assign image_loading = 'eager'
              assign image_priority = 'high'
            endunless
          endif

          assign slide_label = 'slideshow.slide_label' | t: number: forloop.index, total: forloop.length
          assign link_label = slide_settings.title | default: slide_label
          assign image_alt = slide_settings.alt | default: slide_settings.image.alt | default: slide_settings.mobile_image.alt | default: link_label
        %}
        <div
          class="slideshow__slide swiper-slide"
          role="group"
          aria-roledescription="{{ 'slideshow.slide' | t | escape }}"
          aria-label="{{ slide_label | escape }}"
          data-block-id="{{ block.id }}"
          {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="slideshow__media">
            {% render 'slideshow-image',
              image: slide_settings.image,
              mobile_image: slide_settings.mobile_image,
              example_image: slide_settings.example_image,
              alt: image_alt,
              loading: image_loading,
              fetch_priority: image_priority
            %}
            {% if slide_settings.link != blank %}
              <a class="slideshow__link" href="{{ slide_settings.link }}" aria-label="{{ link_label | escape }}"></a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="slideshow__slide swiper-slide">
          <div class="slideshow__media slideshow__placeholder" aria-hidden="true">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="slideshow__controls" hidden>
    <button
      class="slideshow__arrow slideshow__arrow--previous"
      type="button"
      aria-label="{{ 'slideshow.previous' | t | escape }}"
      aria-controls="SlideshowSlides-{{ section.id }}"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path d="m14 5-7 7 7 7" />
      </svg>
    </button>
    <button
      class="slideshow__arrow slideshow__arrow--next"
      type="button"
      aria-label="{{ 'slideshow.next' | t | escape }}"
      aria-controls="SlideshowSlides-{{ section.id }}"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path d="m10 5 7 7-7 7" />
      </svg>
    </button>
    <div class="slideshow__pagination"></div>
  </div>
</hero-slideshow>

{% stylesheet %}
  .slideshow {
    position: relative;
    background: #111;
    color: #fff;
  }

  .slideshow__media {
    position: relative;
    width: 100%;
    aspect-ratio: 8 / 3;
    overflow: hidden;
  }

  .slideshow__media picture,
  .slideshow__image,
  .slideshow__placeholder,
  .slideshow__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .slideshow__image {
    object-fit: cover;
  }

  .slideshow__placeholder svg {
    opacity: 0.2;
  }

  .slideshow__link {
    position: absolute;
    inset: 0;
    display: block;
  }

  .slideshow__link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
  }

  .slideshow__controls[hidden] {
    display: none;
  }

  .slideshow__arrow {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    border-radius: 50%;
    background: rgb(60 60 60 / 55%);
    color: #fff;
    cursor: pointer;
    top: 50%;
    transform: translateY(-50%);
  }

  .slideshow__arrow--previous {
    left: 24px;
  }

  .slideshow__arrow--next {
    right: 24px;
  }

  .slideshow__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .slideshow__arrow:not(:disabled):hover {
    background: rgb(30 30 30 / 85%);
  }

  .slideshow .slideshow__controls .slideshow__pagination {
    position: absolute;
    z-index: 2;
    bottom: 0;
    top: auto;
    left: 50%;
    display: flex;
    justify-content: center;
    gap: 4px;
    width: auto;
    max-width: calc(100% - 128px);
    transform: translateX(-50%);
  }

  .slideshow .slideshow__controls .slideshow__pagination .swiper-pagination-bullet {
    position: relative;
    flex: 0 1 24px;
    width: 24px;
    min-width: 12px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    opacity: 1;
    cursor: pointer;
  }

  .slideshow .swiper-pagination-bullet::after {
    position: absolute;
    right: 0;
    bottom: 17px;
    left: 0;
    height: 4px;
    background: rgb(255 255 255 / 50%);
    box-shadow: 0 1px 2px rgb(0 0 0 / 35%);
    content: '';
  }

  .slideshow .swiper-pagination-bullet-active::after {
    background: #fff;
  }

  .slideshow__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 749px) {
    .slideshow__media {
      aspect-ratio: var(--slideshow-mobile-ratio);
    }

    .slideshow__arrow {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('hero-slideshow')) {
    class HeroSlideshow extends HTMLElement {
      connectedCallback() {
        this.controller = new AbortController();
        const options = { once: true, signal: this.controller.signal };
        const initialize = () => this.initialize();
        document.getElementById('SwiperScript')?.addEventListener('load', initialize, options);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, options);
        else initialize();
      }

      initialize() {
        if (this.swiper || !this.isConnected || !window.Swiper) return;
        if (document.readyState === 'loading' || this.querySelectorAll('.slideshow__slide').length < 2) return;

        this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.controls = this.querySelector('.slideshow__controls');
        const previous = this.querySelector('.slideshow__arrow--previous');
        const next = this.querySelector('.slideshow__arrow--next');

        this.swiper = new Swiper(this.querySelector('.slideshow__viewport'), {
          slidesPerView: 1,
          speed: this.motion.matches ? 0 : Number(this.dataset.speed),
          watchOverflow: true,
          navigation: { prevEl: previous, nextEl: next },
          pagination: { el: this.querySelector('.slideshow__pagination'), clickable: true },
          keyboard: { enabled: false, onlyInViewport: true, pageUpDown: false },
          autoplay: this.dataset.autoplay === 'true' ? {
            delay: Number(this.dataset.interval),
            disableOnInteraction: false,
            pauseOnMouseEnter: true
          } : false,
          a11y: {
            enabled: true,
            prevSlideMessage: previous.getAttribute('aria-label'),
            nextSlideMessage: next.getAttribute('aria-label'),
            firstSlideMessage: this.dataset.firstLabel,
            lastSlideMessage: this.dataset.lastLabel,
            paginationBulletMessage: this.dataset.goToLabel,
            slideLabelMessage: ''
          },
          on: {
            'init slideChange': (swiper) => {
              swiper.slides.forEach((slide, index) => {
                slide.inert = index !== swiper.activeIndex;
                slide.setAttribute('aria-hidden', String(slide.inert));
              });
            },
            'autoplayStart autoplayStop': (swiper) => {
              swiper.wrapperEl.setAttribute('aria-live', swiper.autoplay.running ? 'off' : 'polite');
            }
          }
        });

        this.controls.hidden = false;
        if (this.motion.matches) this.swiper.autoplay.stop();
        const options = { signal: this.controller.signal };

        this.addEventListener('focusin', () => this.swiper.keyboard.enable(), options);

        this.addEventListener('focusout', (event) => {
          if (!this.contains(event.relatedTarget)) this.swiper.keyboard.disable();
        }, options);

        this.addEventListener('shopify:block:select', (event) => {
          this.swiper.autoplay.stop();
          const index = this.swiper.slides.findIndex((slide) => slide.dataset.blockId === event.detail.blockId);
          if (index >= 0) this.swiper.slideTo(index, 0);
        }, options);

        this.addEventListener('shopify:block:deselect', () => {
          if (this.dataset.autoplay === 'true' && !this.motion.matches) this.swiper.autoplay.start();
        }, options);

        this.motion.addEventListener('change', () => {
          this.swiper.params.speed = this.motion.matches ? 0 : Number(this.dataset.speed);
          if (this.motion.matches) this.swiper.autoplay.stop();
        }, options);
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.swiper?.destroy(true, true);
        this.swiper = undefined;
        if (this.controls) this.controls.hidden = true;
      }
    }

    customElements.define('hero-slideshow', HeroSlideshow);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.slideshow",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "checkbox", "id": "autoplay", "label": "t:labels.autoplay", "default": true },
    { "type": "range", "id": "interval", "label": "t:labels.slide_interval", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "speed", "label": "t:labels.transition_speed", "min": 200, "max": 1200, "step": 100, "unit": "ms", "default": 600 },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "t:labels.mobile_ratio",
      "options": [
        { "value": "3 / 4", "label": "t:options.mobile_ratio.portrait" },
        { "value": "1 / 1", "label": "t:options.mobile_ratio.square" },
        { "value": "4 / 3", "label": "t:options.mobile_ratio.landscape" }
      ],
      "default": "3 / 4"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.slide_title" },
        { "type": "image_picker", "id": "image", "label": "t:labels.desktop_image" },
        { "type": "image_picker", "id": "mobile_image", "label": "t:labels.mobile_image" },
        { "type": "text", "id": "alt", "label": "t:labels.image_alt" },
        { "type": "url", "id": "link", "label": "t:labels.slide_link" },
        {
          "type": "select",
          "id": "example_image",
          "label": "t:labels.example_image",
          "info": "t:labels.example_image_info",
          "options": [
            { "value": "none", "label": "t:options.example_image.none" },
            { "value": "sale", "label": "t:options.example_image.sale" },
            { "value": "collection", "label": "t:options.example_image.collection" },
            { "value": "keyboard", "label": "t:options.example_image.keyboard" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.slideshow",
      "blocks": [
        { "type": "slide", "settings": { "example_image": "sale" } },
        { "type": "slide", "settings": { "example_image": "collection" } },
        { "type": "slide", "settings": { "example_image": "keyboard" } }
      ]
    }
  ]
}
{% endschema %}
