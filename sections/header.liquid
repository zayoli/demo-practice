<header class="site-header full-width">
  <div class="site-header__main">
    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <a class="site-header__action" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 5 5" />
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="site-header__action" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t | escape }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a class="site-header__action" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t: count: cart.item_count | escape }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="site-header__count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>

  <nav class="site-header__nav" aria-label="{{ 'header.navigation' | t | escape }}">
    <ul class="site-header__links" role="list">
      {% for link in section.settings.menu.links %}
        <li>
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        </li>
      {% else %}
        <li><a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>{{ 'header.home' | t }}</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'header.shop' | t }}</a></li>
        <li><a href="{{ routes.collections_url }}">{{ 'header.collections' | t }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>

{% stylesheet %}
  .site-header {
    height: 176px;
    display: grid;
    grid-template-rows: 112px 64px;
    background: var(--color-background);
  }

  .site-header__main {
    width: min(100% - 48px, 1280px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header__brand {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
  }

  .site-header__action {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  .site-header__action svg {
    width: 24px;
    height: 24px;
  }

  .site-header__count {
    position: absolute;
    top: 0;
    right: -4px;
    min-width: 18px;
    padding: 2px 4px;
    border-radius: 20px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
  }

  .site-header__nav {
    min-width: 0;
    overflow-x: auto;
    border-block: 1px solid #e4e4df;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 5vw, 64px);
    width: max-content;
    min-width: 100%;
    height: 100%;
    padding-inline: 24px;
    list-style: none;
  }

  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    white-space: nowrap;
  }

  .site-header__links a:hover,
  .site-header__links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (max-width: 600px) {
    .site-header__main {
      width: calc(100% - 32px);
      gap: 8px;
    }

    .site-header__actions {
      gap: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
