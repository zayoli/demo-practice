<link rel="stylesheet" href="{{ 'section-header.css' | asset_url }}">

<header class="site-header full-width">
  <div class="site-header__main">
    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <a class="site-header__action" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 5 5" />
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="site-header__action" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t | escape }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a class="site-header__action" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t: count: cart.item_count | escape }}" aria-haspopup="dialog" aria-controls="CartDrawerDialog" aria-expanded="false" data-cart-open>
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span class="site-header__count" aria-hidden="true" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="site-header__nav" aria-label="{{ 'header.navigation' | t | escape }}">
    <ul class="site-header__links" role="list">
      {% for link in section.settings.menu.links %}
        {% assign menu_link_title = link.title | downcase %}
        <li class="site-header__item{% if menu_link_title == 'main menu' %} site-header__item--collections{% endif %}">
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            {{ link.title | escape }}
            {% if menu_link_title == 'main menu' %}
              <svg class="site-header__caret" viewBox="0 0 10 6" fill="none" aria-hidden="true" focusable="false">
                <path d="m1 1 4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            {% endif %}
          </a>
          {% if menu_link_title == 'main menu' %}
            {% assign menu_collections = section.settings.menu_collections %}
            {% assign menu_collection_handles = 'new-arrival,bundle-deals,best-sellers' | split: ',' %}
            <div class="site-header__mega-menu">
              <div class="site-header__mega-content">
                <div class="site-header__collection-heading">
                  <h2>{{ 'header.shop_by_category' | t }}</h2>
                  <a class="site-header__view-all" href="{{ routes.all_products_collection_url }}">{{ 'header.view_all_products' | t }}</a>
                </div>
                <ul class="site-header__collection-list" role="list">
                  {% if menu_collections != blank %}
                    {% for collection in menu_collections %}
                      {% render 'header-collection-card', collection: collection %}
                    {% endfor %}
                  {% else %}
                    {% for collection_handle in menu_collection_handles %}
                      {% assign collection = collections[collection_handle] %}
                      {% render 'header-collection-card', collection: collection %}
                    {% endfor %}
                  {% endif %}
                </ul>
              </div>
            </div>
          {% endif %}
        </li>
      {% else %}
        <li><a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>{{ 'header.home' | t }}</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'header.shop' | t }}</a></li>
        <li><a href="{{ routes.collections_url }}">{{ 'header.collections' | t }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>


{% schema %}
{
  "name": "t:general.header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "collection_list",
      "id": "menu_collections",
      "label": "t:labels.menu_collections",
      "limit": 3
    }
  ]
}
{% endschema %}
