{% doc %}
  Renders a store product with clickable color swatches and its variant price.

  @param {product} card_product - A product from the tab's collection
  @param {string} form_id - A unique product form ID
  @param {string} [promotion] - Optional promotional text

  @example
  {% render 'top-picks-card', card_product: product, form_id: 'FeaturedProduct' %}
{% enddoc %}

{% liquid
  assign card_title = card_product.title
  assign card_url = card_product.url
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_image = card_variant.featured_image | default: card_product.featured_image
  assign card_color_option = nil
  for product_option in card_product.options_with_values
    assign option_name = product_option.name | downcase
    assign swatch_count = product_option.values | map: 'swatch' | compact | size
    if swatch_count > 0
      assign card_color_option = product_option
      break
    elsif option_name == 'color' or option_name == 'colour'
      assign card_color_option = product_option
    elsif option_name == '颜色' or option_name == '顏色'
      assign card_color_option = product_option
    endif
  endfor
  if card_color_option != nil
    assign card_url = card_variant.url | default: card_url
  endif
  assign card_quick_add = false
  unless card_product.requires_selling_plan
    if card_product.has_only_default_variant
      assign card_quick_add = true
    elsif card_product.options.size == 1
      if card_color_option != nil
        assign card_quick_add = true
      endif
    endif
  endunless
%}

<top-picks-card class="picks-card" role="article">
  <div class="picks-card__visual">
    <a class="picks-card__media" href="{{ card_url | escape }}" aria-label="{{ card_title | escape }}" data-card-link>
      {% if card_image != blank %}
        {{ card_image | image_url: width: 800 | image_tag: class: 'picks-card__image', loading: 'lazy', widths: '280, 400, 560, 800', sizes: '(min-width: 1440px) 340px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw', alt: card_title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'picks-card__placeholder' }}
      {% endif %}
    </a>
    {% if card_color_option.values.size > 1 %}
      {% assign color_option_index = card_color_option.position | minus: 1 %}
      <div class="picks-card__swatches swiper-no-swiping" role="group" aria-label="{{ 'top_picks.colors_for' | t: product: card_title | escape }}">
        {% for color_value in card_color_option.values %}
          {% liquid
            assign color_variant = color_value.variant
            assign color_url = color_variant.url | default: color_value.product_url | default: card_product.url
            assign color_image = color_variant.featured_image | default: card_product.featured_image
            assign color_selected = false
            if card_variant.options[color_option_index] == color_value.name
              assign color_selected = true
            endif
            assign color_label = color_value.name
            unless color_value.available
              assign color_label = 'top_picks.color_unavailable' | t: color: color_value.name
            endunless
          %}
          <a
            class="picks-card__swatch"
            href="{{ color_url | escape }}"
            role="button"
            aria-pressed="{{ color_selected }}"
            aria-label="{{ color_label | escape }}"
            title="{{ color_label | escape }}"
            data-swatch-color="{{ color_value.swatch.color | default: color_value.name | escape }}"
            {% if color_variant != blank %}
              data-card-variant="{{ color_variant.id }}"
              data-available="{{ color_variant.available }}"
              data-price="{{ color_variant.price | money_with_currency | escape }}"
              data-compare-price="{% if color_variant.compare_at_price > color_variant.price %}{{ color_variant.compare_at_price | money_with_currency | escape }}{% endif %}"
            {% endif %}
          >
            <span class="picks-card__swatch-chip" aria-hidden="true">
              {% if color_value.swatch.image != blank %}
                {{ color_value.swatch.image | image_url: width: 48 | image_tag: class: 'picks-card__swatch-image', loading: 'lazy', widths: '24, 48', sizes: '24px', alt: '' }}
              {% else %}
                <span class="picks-card__swatch-name">{{ color_value.name | escape }}</span>
              {% endif %}
            </span>
            <template data-card-image>
              {% if color_image != blank %}
                {{ color_image | image_url: width: 800 | image_tag: class: 'picks-card__image', loading: 'lazy', widths: '280, 400, 560, 800', sizes: '(min-width: 1440px) 340px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw', alt: card_title }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'picks-card__placeholder' }}
              {% endif %}
            </template>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="picks-card__body">
    {% if promotion != blank %}<p class="picks-card__promotion">{{ promotion | escape }}</p>{% endif %}
    <h3 class="picks-card__title"><a href="{{ card_url | escape }}" title="{{ card_title | escape }}" data-card-link>{{ card_title | escape }}</a></h3>
    <div class="picks-card__price" aria-live="polite" aria-atomic="true">
      <span data-card-price>{{ card_variant.price | money_with_currency }}</span>
      <s data-card-compare-price {% unless card_variant.compare_at_price > card_variant.price %}hidden{% endunless %}>{% if card_variant.compare_at_price > card_variant.price %}{{ card_variant.compare_at_price | money_with_currency }}{% endif %}</s>
    </div>

    {% if card_quick_add %}
      {% form 'product', card_product, id: form_id, class: 'picks-card__form', data-cart-add: 'true', data-variant-available: card_variant.available %}
        <input type="hidden" name="id" value="{{ card_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="picks-card__button" type="submit" data-add-label="{{ 'top_picks.add_to_cart' | t | escape }}" data-sold-out-label="{{ 'top_picks.sold_out' | t | escape }}" {% unless card_variant.available %}disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M3 3h2l3 12h10l3-9H6M10 20h.01M18 20h.01" stroke-linecap="round" /></svg>
          <span data-card-submit-text>{% if card_variant.available %}{{ 'top_picks.add_to_cart' | t }}{% else %}{{ 'top_picks.sold_out' | t }}{% endif %}</span>
        </button>
        <p class="picks-card__error" role="alert" data-cart-error hidden></p>
      {% endform %}
    {% else %}
      <a class="picks-card__button" href="{{ card_url | escape }}" data-card-link>{{ 'top_picks.choose_options' | t }}</a>
    {% endif %}
  </div>
</top-picks-card>
