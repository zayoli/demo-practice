{% doc %}
  Renders a product card, or one reference product when no catalog is configured.

  @param {product} [card_product] - A product from the selected collection or list
  @param {string} [form_id] - A unique product form ID
  @param {string} [promotion] - Optional promotional text
  @param {string} [example_group] - Reference category for the empty catalog
  @param {number} [example_index] - Zero-based reference product index

  @example
  {% render 'top-picks-card', card_product: product, form_id: 'FeaturedProduct' %}
{% enddoc %}

{% liquid
  if card_product != blank
    assign card_title = card_product.title
    assign card_url = card_product.url
    assign card_variant = card_product.selected_or_first_available_variant
  else
    case example_group
      when 'new_arrivals'
        assign example_rows = 'fizz-k617-60-white-japanese-jis-mechanical-keyboard|FIZZ K617 60% Japanese JIS Mechanical Keyboard|54.99|0|0|0;fizz-k617-60-white-grey-uk-qwerty-compact-mechanical-keyboard|FIZZ K617 60% White & Grey UK QWERTY|39.99|0|0|0;ucal-k673-uk|UCAL K673 PRO UK QWERTY Keyboard|64.99|0|0|0;eisa-k686-pro-xmas-edition|EISA K686 PRO (Xmas Edition)|59.99|74.99|0|0;k688|BRAGI K688 PRO Korean Layout Keyboard|62.99|0|0|0;ws7022-wireless-deskset-air-plus|WS7022 Wireless DeskSet Air Plus|44.99|0|0|0'
      when 'bundle_deals'
        assign example_rows = 'bs8773-wireless-keyboard-and-mouse-combo|BS8773 Wireless Keyboard and Mouse Combo|36.99|0|4.86|29;artemis-k719-pro-keyboard-predator-m612-pro-mouse-anime-combo|ARTEMIS K719 PRO & PREDATOR M612 PRO Anime Combo|94.99|0|5|6;horus-k618-ultra-slim-keyboard-trident-m693-mouse-combo|HORUS K618 & TRIDENT M693 Tri-Mode Combo|89.99|94.99|4.45|22;s168-3-mode-wireless-gaming-keyboard-mouse-combo|S168 Wireless Gaming Keyboard & Mouse Combo|59.99|0|4.33|3;bs7552-wireless-keyboard-and-mouse-combo|BS7552 Wireless Keyboard and Mouse Combo|44.99|0|4.87|52;eisa-k686-keyboard-and-m916-1k-hz-mouse-anime-combo|EISA K686 PRO SE & K1NG M916 PRO Anime Combo|89.99|0|4.83|29'
      else
        assign example_rows = 'impact-m908|IMPACT M908|32.99|0|4.67|367;m913|IMPACT ELITE M913|46.99|0|4.62|258;draconic-k530-white|DRACONIC K530 PRO WHITE (Brown Switches)|49.99|59.99|4.76|135;horus-k618-ultrathin-wireless-keyboard|HORUS K618 Ultra-slim Wireless Mechanical Keyboard|64.99|0|4.66|177;small-mechanical-keyboard|FIZZ K617 60% White & Grey Mechanical Keyboard|44.99|47.99|4.79|136;h510-zeus-white|H510 ZEUS WHITE & PINK|61.99|66.99|4.89|98'
    endcase
    assign example_rows = example_rows | split: ';'
    assign example = example_rows[example_index] | split: '|'
    assign card_title = example[1]
    assign example_compare = example[3] | plus: 0
    assign example_rating = example[4] | plus: 0
    assign example_reviews = example[5] | plus: 0
    assign star_fill = example_rating | times: 20
    capture card_url
      echo 'https://redragonshop.com/products/'
      echo example[0]
    endcapture
    capture example_asset
      echo 'top-picks-'
      echo example_group
      echo '-'
      echo example_index | plus: 1
      echo '.webp'
    endcapture
  endif
%}

<article class="picks-card">
  <a class="picks-card__media" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
    {% if card_product != blank %}
      {% if card_product.featured_image != blank %}
        {{ card_product.featured_image | image_url: width: 800 | image_tag: class: 'picks-card__image', loading: 'lazy', widths: '280, 400, 560, 800', sizes: '(min-width: 1440px) 340px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'picks-card__placeholder' }}
      {% endif %}
      {% if card_product.images[1] != blank %}
        {{ card_product.images[1] | image_url: width: 800 | image_tag: class: 'picks-card__image picks-card__image--alternate', loading: 'lazy', widths: '280, 400, 560, 800', sizes: '(min-width: 1440px) 340px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw', alt: '' }}
      {% endif %}
    {% else %}
      <img class="picks-card__image" src="{{ example_asset | asset_url }}" alt="{{ card_title | escape }}" width="640" height="640" loading="lazy">
    {% endif %}
  </a>

  <div class="picks-card__body">
    {% if promotion != blank %}<p class="picks-card__promotion">{{ promotion | escape }}</p>{% endif %}
    <h3 class="picks-card__title"><a href="{{ card_url }}" title="{{ card_title | escape }}">{{ card_title | escape }}</a></h3>
    {% if card_product == blank %}
      {% if example_reviews > 0 %}
        <div class="picks-card__rating" aria-label="{{ 'top_picks.rating' | t: rating: example_rating, count: example_reviews | escape }}">
          <span class="picks-card__stars" style="--star-fill: {{ star_fill }}%;" aria-hidden="true">★★★★★</span>
          <span aria-hidden="true">({{ example_reviews }})</span>
        </div>
      {% else %}
        <p class="picks-card__no-reviews">{{ 'top_picks.new_arrival' | t }}</p>
      {% endif %}
    {% endif %}
    <div class="picks-card__price">
      {% if card_product != blank %}
        <span>{{ card_variant.price | money_with_currency }}</span>
        {% if card_variant.compare_at_price > card_variant.price %}<s>{{ card_variant.compare_at_price | money_with_currency }}</s>{% endif %}
      {% else %}
        <span>{{ 'top_picks.example_price' | t: amount: example[2] }}</span>
        {% if example_compare > 0 %}<s>{{ 'top_picks.example_price' | t: amount: example[3] }}</s>{% endif %}
      {% endif %}
    </div>

    {% if card_product != blank %}
      {% if card_product.has_only_default_variant %}
        {% if card_product.requires_selling_plan %}
          <a class="picks-card__button" href="{{ card_url }}">{{ 'top_picks.choose_options' | t }}</a>
        {% else %}
          {% form 'product', card_product, id: form_id, class: 'picks-card__form' %}
            <input type="hidden" name="id" value="{{ card_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="picks-card__button" type="submit" {% unless card_variant.available %}disabled{% endunless %}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M3 3h2l3 12h10l3-9H6M10 20h.01M18 20h.01" stroke-linecap="round" /></svg>
              {% if card_variant.available %}{{ 'top_picks.add_to_cart' | t }}{% else %}{{ 'top_picks.sold_out' | t }}{% endif %}
            </button>
          {% endform %}
        {% endif %}
      {% else %}
        <a class="picks-card__button" href="{{ card_url }}">{{ 'top_picks.choose_options' | t }}</a>
      {% endif %}
    {% else %}
      <a class="picks-card__button" href="{{ card_url }}">{{ 'top_picks.view_product' | t }}</a>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .picks-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid #333;
    border-radius: 12px;
    background: radial-gradient(ellipse at 50% 25%, #292929, #131313 75%);
    color: #fff;
  }
  .picks-card__media { position: relative; display: block; aspect-ratio: 1; overflow: hidden; }
  .picks-card__image, .picks-card__placeholder { width: 100%; height: 100%; object-fit: contain; }
  .picks-card__placeholder { fill: #555; }
  .picks-card__image--alternate { position: absolute; inset: 0; opacity: 0; transition: opacity 200ms; }
  .picks-card__body { display: flex; flex: 1; flex-direction: column; gap: 10px; padding: 0 28px 28px; }
  .picks-card__promotion { color: #ff5662; font-size: 14px; line-height: 1.5; }
  .picks-card__title { overflow: hidden; font-size: 18px; font-weight: 500; line-height: 1.5; }
  .picks-card__title a { display: block; overflow: hidden; color: inherit; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
  .picks-card__rating { display: flex; align-items: center; gap: 5px; font-size: 14px; }
  .picks-card__stars { background: linear-gradient(90deg, #ffca28 var(--star-fill), #777 var(--star-fill)); background-clip: text; color: transparent; font-size: 20px; line-height: 1; }
  .picks-card__no-reviews { min-height: 21px; color: #c5c5c5; font-size: 13px; }
  .picks-card__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin-bottom: 6px; font-size: 18px; }
  .picks-card__price s { color: #bfbfbf; font-size: 14px; }
  .picks-card__form { margin-top: auto; }
  .picks-card__button { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 46px; margin-top: auto; padding: 10px 8px; border: 0; border-radius: 4px; background: #cf2639; color: #fff; font: inherit; font-size: 15px; line-height: 24px; text-align: center; text-decoration: none; cursor: pointer; }
  .picks-card__button svg { width: 24px; height: 24px; }
  .picks-card__button:disabled { background: #555; color: #ddd; cursor: default; }
  .picks-card__button:not(:disabled):hover { background: #a91e2e; }
  .picks-card a:focus-visible { outline-offset: -4px; }
  @media (hover: hover) {
    .picks-card__media:hover .picks-card__image--alternate { opacity: 1; }
  }
  @media (max-width: 749px) {
    .picks-card__body { gap: 8px; padding: 0 20px 22px; }
    .picks-card__title, .picks-card__price { font-size: 16px; }
    .picks-card__promotion { font-size: 12px; }
    .picks-card__price s { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .picks-card__image--alternate { transition: none; }
  }
{% endstylesheet %}
