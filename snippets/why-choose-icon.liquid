{% doc %}
  Renders a decorative service icon with black outlines and red accents.

  @param {string} icon - shipping, returns, warranty, or rewards

  @example
  {% render 'why-choose-icon', icon: 'shipping' %}
{% enddoc %}

<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {% case icon %}
    {% when 'returns' %}
      <g stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 26A13 13 0 1 1 29 12M16 15l5-5" stroke="#ea0029" />
        <path d="M10 42v-6a7 7 0 0 1 7-7h5v-4a3 3 0 0 1 3-3h17a3 3 0 0 1 3 3v17M22 29v4" stroke="currentColor" />
        <circle cx="20" cy="42" r="3" stroke="currentColor" /><circle cx="35" cy="42" r="3" stroke="currentColor" />
      </g>
    {% when 'warranty' %}
      <path d="m6 9 18-5 18 5v11c0 12-7 21-18 25C13 41 6 32 6 20V9Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
      <path d="m15 23 7 7 12-12" stroke="#ea0029" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    {% when 'rewards' %}
      <g stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 23h34v8H7zM11 31v13h26V31M24 23v21" stroke="currentColor" />
        <path d="M24 23c-9 0-13-3-13-7 0-3 3-5 6-3 4 2 7 10 7 10Zm0 0c9 0 13-3 13-7 0-3-3-5-6-3-4 2-7 10-7 10Z" stroke="currentColor" />
        <path d="m37 2 2 4 4 2-4 2-2 4-2-4-4-2 4-2 2-4ZM7 7v5M4.5 9.5h5" stroke="#ea0029" />
      </g>
    {% else %}
      <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 16h42v27a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V16ZM3 16 8 6a7 7 0 0 1 6-4h20a7 7 0 0 1 6 4l5 10M24 2v14M30 38h7" />
      </g>
      <text x="24" y="31" text-anchor="middle" fill="#ea0029" font-family="Arial, sans-serif" font-size="12" font-weight="700">U.S.</text>
  {% endcase %}
</svg>
