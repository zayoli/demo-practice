<!doctype html>
<html lang="{{ request.locale.iso_code }}" {% render 'theme-settings' %}>
  <head>
    {% render 'meta-tags' %}
    <script src="{{ 'theme-settings.js' | asset_url }}" defer></script>
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" id="SwiperScript" defer></script>
    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'cart-drawer' %}
    {% sections 'footer-group' %}
  </body>
</html>
