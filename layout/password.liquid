<!doctype html>
<html lang="{{ request.locale.iso_code }}" {% render 'theme-settings' %}>
  <head>
    <script src="{{ 'theme-settings.js' | asset_url }}" defer></script>

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
